{
  "schema_version": 1,
  "defaults": {
    "launcher": [
      "mpirun",
      "-np",
      "6"
    ],
    "base_args": [
      "-no-glvis"
    ],
    "workdir": ".",
    "env": {
      "OMP_NUM_THREADS": "1"
    },
    "keep_going": true
  },
  "cases": [
    {
      "name": "sedov_taylor_blast",
      "executable": "./build/examples/sedov_taylor_blast/sedov_taylor_blast",
      "base_args": [
        "-is",
        "L2",
        "-ig",
        "L2"
      ],
      "sweep": {
        "-ca": [
          5.0
        ],
        "-o": [
          3
        ],
        "-rs": [
          0
        ],
        "-rp": [
          0,
          1
        ],
        "-tf": [
          1.0
        ],
        "-dt_save": [
          0.01
        ],
        "-c": [
          0.25
        ]
      }
    },
    {
      "name": "inoue_hattori_large_domain_slip_tb",
      "executable": "./build/examples/inoue_hattori_large_domain/inoue_hattori_large_domain_slip_tb",
      "base_args": [
        "-is",
        "L2",
        "-ig",
        "L2"
      ],
      "sweep": {
        "-ca": [
          5.0
        ],
        "-o": [
          3
        ],
        "-rs": [
          0
        ],
        "-rp": [
          0,
          1
        ],
        "-tf": [
          10.0
        ],
        "-dt_save": [
          0.1
        ],
        "-c": [
          0.25
        ]
      }
    }
  ]
}
