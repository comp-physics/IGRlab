{
  "schema_version": 1,
  "defaults": {
    "launcher": [
      "mpirun",
      "-np",
      "1"
    ],
    "base_args": [
      "-no-vtk",
      "-no-glvis",
      "-iprint",
      "0"
    ],
    "workdir": ".",
    "env": {
      "OMP_NUM_THREADS": "1"
    },
    "keep_going": true
  },
  "cases": [
    {
      "name": "sedov_taylor_blast",
      "executable": "./build/examples/sedov_taylor_blast/sedov_taylor_blast",
