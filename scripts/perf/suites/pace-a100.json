        "kernel_groups": {
          "volume_coefficients": "BorrowedEulerTensorVolumeCoefficientKernel",
          "volume_contraction": "BorrowedEulerTensorVolumeContractionKernel",
          "condensation": "BorrowedCondenseKernel", "face": "BorrowedEulerFaceKernel",
