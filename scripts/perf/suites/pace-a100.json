    },
    {
      "id": "hdg-igr-ordinary-p3",
      "adapter": "hdg",
      "parameters": {"mode": "igr", "engine": "ordinary", "order": 3, "mesh_n": 16},
      "profile": {
        "selection": "first-per-kernel", "launch_skip": 0, "launch_count": 32,
        "kernel_regex": ".*(?:BorrowedEulerVolumeKernel|BorrowedCondenseKernel|BorrowedEulerFaceKernel|BorrowedRetainedLuRecoverKernel|cusparse::spsm_v2_kernel).*",
        "kernel_groups": {
          "volume": "BorrowedEulerVolumeKernel", "condensation": "BorrowedCondenseKernel",
          "face": "BorrowedEulerFaceKernel", "recovery": "BorrowedRetainedLuRecoverKernel",
          "triangular_solve": "cusparse::spsm_v2_kernel"
        }
      }
