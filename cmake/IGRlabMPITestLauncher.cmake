# Rank-one target tests need the MPI process manager on sites that disable
# singleton MPI initialization. Explicit mpiexec/script tests keep their own
# commands: CMake applies TEST_LAUNCHER only when COMMAND names a target.
option(IGRLAB_MPI_TEST_LAUNCHER
       "Launch direct MFEM/MPI executable tests through mpiexec with one rank" OFF)

function(_igrlab_target_uses_mpi target result)
    set(pending "${target}")
    set(visited "")
    while(pending)
        list(POP_FRONT pending current)
        if(current IN_LIST visited)
            continue()
        endif()
        list(APPEND visited "${current}")
        if(current STREQUAL "mfem" OR current STREQUAL "MPI::MPI_CXX" OR
           current STREQUAL "MPI::MPI_C")
            set(${result} TRUE PARENT_SCOPE)
            return()
        endif()
        if(NOT TARGET "${current}")
            continue()
        endif()
        get_target_property(links "${current}" LINK_LIBRARIES)
        get_target_property(interface_links "${current}" INTERFACE_LINK_LIBRARIES)
        foreach(link IN LISTS links interface_links)
            # PRIVATE static links appear in consumer interfaces as LINK_ONLY.
            string(REGEX REPLACE "^\\$<LINK_ONLY:([^>]+)>$" "\\1" link "${link}")
            if(TARGET "${link}")
                list(APPEND pending "${link}")
            endif()
        endforeach()
    endwhile()
    set(${result} FALSE PARENT_SCOPE)
endfunction()

function(_igrlab_set_mpi_test_launchers directory launcher)
    get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    foreach(target IN LISTS targets)
        get_target_property(kind "${target}" TYPE)
        if(NOT kind STREQUAL "EXECUTABLE")
            continue()
        endif()
        _igrlab_target_uses_mpi("${target}" uses_mpi)
        if(uses_mpi)
            get_target_property(existing "${target}" TEST_LAUNCHER)
            if(existing AND NOT existing STREQUAL launcher)
                message(FATAL_ERROR
                        "MPI test launcher conflicts with TEST_LAUNCHER on '${target}'.")
            endif()
            set_property(TARGET "${target}" PROPERTY TEST_LAUNCHER "${launcher}")
        endif()
    endforeach()
    get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(child IN LISTS children)
        _igrlab_set_mpi_test_launchers("${child}" "${launcher}")
    endforeach()
endfunction()

function(igrlab_configure_mpi_test_launchers)
    if(NOT IGRLAB_MPI_TEST_LAUNCHER)
        return()
    endif()
    if(CMAKE_VERSION VERSION_LESS 3.29)
        message(FATAL_ERROR "IGRLAB_MPI_TEST_LAUNCHER requires CMake >= 3.29.")
    endif()
    if(NOT MFEM_USE_MPI)
        message(FATAL_ERROR "IGRLAB_MPI_TEST_LAUNCHER requires MPI-enabled MFEM.")
    endif()
    if(NOT MPIEXEC_EXECUTABLE OR NOT EXISTS "${MPIEXEC_EXECUTABLE}" OR
       NOT MPIEXEC_NUMPROC_FLAG)
        message(FATAL_ERROR "MPI test launcher requires the selected MPIEXEC_EXECUTABLE and MPIEXEC_NUMPROC_FLAG.")
    endif()
    if(MPIEXEC_POSTFLAGS)
        message(FATAL_ERROR "MPI test launcher requires empty MPIEXEC_POSTFLAGS; TEST_LAUNCHER prefixes the executable.")
    endif()
    set(launcher "${MPIEXEC_EXECUTABLE}" "${MPIEXEC_NUMPROC_FLAG}" 1 ${MPIEXEC_PREFLAGS})
    _igrlab_set_mpi_test_launchers("${CMAKE_SOURCE_DIR}" "${launcher}")
endfunction()
